# URL pública del proyecto Supabase (no es un secreto).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publicable de Supabase (no es un secreto; nunca uses service_role aquí).
VITE_SUPABASE_PUBLISHABLE_KEY=tu-clave-publicable-supabase

# URL pública o local del panel de facturación electrónica (no es un secreto).
VITE_FACTURADOR_APP_URL=http://localhost:3000

# La aplicación no usa claves de IA. No agregues secretos ni service_role.
# Consulta docs/AI_KEYS.md para más información.
